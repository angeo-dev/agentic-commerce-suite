        "answer-engine-optimization",
        "agentic-commerce",
        "llms-txt",
        "ucp",
        "mcp",
        "webmcp",
        "acp",
        "ai-agents",
        "hyva",
        "adobe-commerce",
        "mage-os"
    ],
    "homepage": "https://angeo.dev",
    "support": {
        "issues": "https://github.com/angeo-dev/agentic-commerce-suite/issues",
        "email": "support@angeo.dev",
        "docs": "https://angeo.dev/modules/"
    },
    "require": {
        "angeo/module-llms-txt": "^4.3.3",
        "angeo/module-robots-txt-aeo": "^4.0.1",
        "angeo/module-rich-data": "^2.0",
        "angeo/module-aeo-audit": "^4.2.3",
        "angeo/module-openai-product-feed": "^2.1",
        "angeo/module-openai-product-feed-api": "^2.0.1",
        "angeo/module-ucp": "^2.2",
        "angeo/module-ucp-catalog": "^2.1.1",
        "angeo/module-ucp-checkout": "^1.1",
        "angeo/module-ucp-checkout-mcp": "^1.0",
        "angeo/module-mcp-server": "^2.2.2",
        "angeo/module-mcp-checkout": "^2.1.3",
        "angeo/module-webmcp": "^1.0.1",
        "angeo/module-agent-activity": "^1.0"
